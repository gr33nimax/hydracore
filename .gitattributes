# A GNU makefile is line-oriented text, not a Windows artifact: keep it LF in
# the working tree so analysers see the same bytes the index holds. The shell
# scripts are checked with shellcheck, which reads a carriage return as part of
# the command, and the Go toolchain is happier without CRLF either.
Makefile text eol=lf
*.sh text eol=lf
*.go text eol=lf
# shellcheck reads this file to apply its own disable directives. A CRLF
# checkout breaks that parsing: the value becomes `SC1017\r`, so the directive
# is ignored and the carriage returns are reported against whichever script is
# being checked.
.shellcheckrc text eol=lf
